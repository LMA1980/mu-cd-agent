# ==============================================================================
# MuCD Node Agent Configuration Environment
# Path: /etc/mu-cd-agent/agent.env (Permissions: 0600 root:root)
# ==============================================================================

# Logical node identifier (e.g., node-a, node-b, worker-riscv64, worker-aarch64)
MU_CD_AGENT_NODE_ID=worker-node

# mTLS IPC listen address for mu-cd-controller connections
MU_CD_AGENT_LISTEN_ADDR=0.0.0.0:8446

# Base Btrfs root for per-service @a/@b/current/snapshots subvolumes
MU_CD_ROOT=/srv/mucd

# step-ca mTLS credentials for mu-cd-ipc
# MU_CD_AGENT_TLS_CA_CERT=/etc/mu-cd-agent/ca.crt
# MU_CD_AGENT_TLS_SERVER_CERT=/etc/mu-cd-agent/server.crt
# MU_CD_AGENT_TLS_SERVER_KEY=/etc/mu-cd-agent/server.key

# Directory searched for .mucd/mu-cd.yml (with legacy .muconde/MuConDe.yml fallback)
# MU_CD_AGENT_MANIFEST_DIR=.

# Integration gate selector ("all" or comma-separated test names)
# MU_CD_AGENT_INTEGRATION_TESTS=all

# Optional mu-registry endpoint, bearer token file, and local CAS blob store
# MU_CD_AGENT_REGISTRY_URL=https://registry.ci.internal:8444
# MU_CD_AGENT_REGISTRY_TOKEN_FILE=/etc/mu-cd-agent/registry_token
# MU_CD_AGENT_CAS_BLOBS_DIR=/var/lib/mu-registry

# Optional mu-observable-collector MUOB TCP telemetry endpoint
# MU_OBSERVABLE_COLLECTOR_ADDR=127.0.0.1:4319

# Tracing and logging level
RUST_LOG=info,mu_cd_agent=debug
